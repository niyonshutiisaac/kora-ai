# Kora environment configuration.
# Copy this file to `.env` and fill in the keys you use.
# Cloud providers are optional - Ollama works fully offline with no key.

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (free models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NVIDIA NIM (free tier, 100+ models) - https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local Ollama server (default shown)
OLLAMA_BASE_URL=http://localhost:11434
